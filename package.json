{
  "name": "dsh-uyghurche-ui",
  "version": "0.1.0",
  "description": "DSH Web GUI Uyghur (UEY) interface language pack: registers ئۇيغۇرچە through the official locale API (ctx.locale.addLanguage + register) with per-key English fallback — 1,069 keys across all official UI namespaces except trajectory, plus full-UI RTL mirroring and Intl locale hooks.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "uyghur",
    "uyghurche",
    "维吾尔语",
    "UEY",
    "locale",
    "interface",
    "language-pack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Furdavus/dsh-uyghurche-ui"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale"],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
